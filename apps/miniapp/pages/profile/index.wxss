.profile-page {
  padding-bottom: 100rpx;
}

.profile-header {
  padding: 48rpx 24rpx 24rpx;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 700;
}

.profile-stats {
  display: flex;
  padding: 0 24rpx 24rpx;
  gap: 24rpx;
}

.profile-stat {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.profile-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand-500);
  display: block;
}

.profile-stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
}

.profile-menu {
  padding: 0 24rpx;
}

.profile-menu-item {
  background: var(--bg-card);
  padding: 28rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
}

.profile-menu-item:active { background: rgba(0,0,0,0.03); transform: scale(0.98); transition: transform 0.1s; }
.profile-stat:active { opacity: 0.7; }

.profile-skeleton { width: 200rpx; height: 44rpx; background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; border-radius: 8rpx; }
