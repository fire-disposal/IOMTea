.health-page {
  padding: 0 24rpx 160rpx;
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.health-title {
  font-size: 40rpx;
  font-weight: 700;
}

.health-gear {
  font-size: 36rpx;
  padding: 8rpx;
}

.health-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.health-stat {
  flex: 1;
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 24rpx;
  text-align: center;
}

.health-stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-500);
  display: block;
}

.health-stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.module-card {
  width: calc((100% - 16rpx) / 2);
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.module-card:active {
  transform: scale(0.97);
  transition: transform 0.1s;
}

.module-card-icon {
  font-size: 44rpx;
}

.module-card-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.module-card-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.module-card--loading {
  height: 180rpx;
  opacity: 0.3;
  background: var(--text-secondary);
}

.health-cal-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.health-cal-toggle-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.health-cal-toggle-arrow {
  font-size: 20rpx;
  color: var(--text-secondary);
  transition: transform 0.2s;
  display: inline-block;
}

.health-cal-toggle-arrow-up {
  transform: rotate(180deg);
}

.calendar {
  margin-bottom: 24rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
}

.cal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
}

.cal-nav {
  font-size: 40rpx;
  color: var(--brand-500);
  padding: 0 16rpx;
}

.cal-month-label {
  font-size: 30rpx;
  font-weight: 600;
}

.cal-weekdays { display: flex; }
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.cal-grid { display: flex; flex-wrap: wrap; }
.cal-day {
  width: calc(100% / 7);
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  position: relative;
}
.cal-day--empty { color: #ddd; }
.cal-day--active { color: var(--brand-500); font-weight: 600; }

.cal-dot {
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--brand-500);
  margin: 4rpx auto 0;
}

.health-links {
  display: flex;
  gap: 16rpx;
}

.health-link {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 24rpx;
}

.health-link-icon { font-size: 32rpx; }
.health-link-text { font-size: 26rpx; color: var(--text-primary); }

.health-gear:active { opacity: 0.6; transform: scale(0.9); transition: opacity 0.1s, transform 0.1s; }
.health-link:active { transform: scale(0.97); transition: transform 0.1s; }
.health-cal-toggle:active { opacity: 0.7; }
