<view class="health-page">
  <view class="health-header">
    <text class="health-title">健康记录</text>
    <text class="health-gear" bind:tap="onTrackingTap">⚙️</text>
  </view>

  <!-- Quick stats -->
  <view class="health-stats">
    <view class="health-stat">
      <text class="health-stat-num">{{totalToday}}</text>
      <text class="health-stat-label">今日记录</text>
    </view>
    <view class="health-stat">
      <text class="health-stat-num">{{activeModules}}</text>
      <text class="health-stat-label">活跃模块</text>
    </view>
  </view>

  <!-- Module grid -->
  <view class="module-grid">
    <view wx:if="{{!loaded}}" wx:for="{{[1,2,3,4]}}" wx:key="*this" class="module-card module-card--loading anim-pulse"></view>

    <view wx:if="{{loaded}}" wx:for="{{modules}}" wx:key="key" class="module-card anim-fade-up"
      data-page="{{item.page}}" bind:tap="onModuleTap">
      <text class="module-card-icon">{{item.icon}}</text>
      <text class="module-card-label">{{item.label}}</text>
      <text class="module-card-count">{{counts[item.key] > 0 ? '今日' + counts[item.key] + '次' : '未记录'}}</text>
    </view>
  </view>

  <!-- Calendar toggle -->
  <view class="health-cal-toggle" bind:tap="onToggleCal">
    <text class="health-cal-toggle-text">{{calVisible ? '收起日历' : '展开日历'}}</text>
    <text class="health-cal-toggle-arrow {{calVisible ? 'health-cal-toggle-arrow-up' : ''}}">▼</text>
  </view>

  <view wx:if="{{calVisible}}" class="calendar anim-fade-up">
    <view class="cal-header">
      <text class="cal-nav" bind:tap="onPrevMonth">‹</text>
      <text class="cal-month-label">{{monthLabel}}</text>
      <text class="cal-nav" bind:tap="onNextMonth">›</text>
    </view>
    <view class="cal-weekdays">
      <text wx:for="{{weekDays}}" wx:key="*this" class="cal-wd">{{item}}</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{calendarDays}}" wx:key="index"
        class="cal-day {{item.active ? 'cal-day--active' : ''}} {{item.day ? '' : 'cal-day--empty'}}"
        data-date="{{item.date}}" data-count="{{item.count}}" bind:tap="onDayTap">
        <text wx:if="{{item.day}}">{{item.day}}</text>
        <view wx:if="{{item.active && item.day}}" class="cal-dot"></view>
      </view>
    </view>
  </view>

  <!-- Quick links -->
  <view class="health-links">
    <view class="health-link" bind:tap="onFormListTap">
      <text class="health-link-icon">📋</text>
      <text class="health-link-text">健康量表</text>
    </view>
    <view class="health-link" bind:tap="onRecordsTap">
      <text class="health-link-icon">📂</text>
      <text class="health-link-text">全部记录</text>
    </view>
  </view>
</view>
