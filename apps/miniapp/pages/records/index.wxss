.records-page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.records-back {
  font-size: 28rpx;
  color: var(--brand-500);
  width: 96rpx;
}

.records-title {
  font-size: 36rpx;
  font-weight: 700;
}

.record-item {
  background: var(--bg-card);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.record-item-time {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.record-item-value {
  font-size: 28rpx;
  margin-top: 4rpx;
  display: block;
}

.records-skeleton .record-item-skeleton {
  height: 60rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: var(--text-secondary);
  opacity: 0.1;
}

.records-empty {
  text-align: center;
  padding: 120rpx 0;
}

.records-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.records-empty-text {
  font-size: 30rpx;
  display: block;
  margin-bottom: 8rpx;
}

.records-empty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.records-empty-btn {
  background: var(--brand-500);
  color: #fff;
  border-radius: 12rpx;
  display: inline-block;
  padding: 16rpx 48rpx;
}

.record-item:active { background: rgba(0,0,0,0.03); }
