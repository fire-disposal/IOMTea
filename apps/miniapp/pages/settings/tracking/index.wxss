.tracking-page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.tracking-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.tracking-back {
  font-size: 28rpx;
  color: var(--brand-500);
  margin-right: 16rpx;
}

.tracking-title {
  font-size: 36rpx;
  font-weight: 700;
}

.tracking-item {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.tracking-item-row {
  display: flex;
  align-items: center;
}

.tracking-item-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.tracking-item-label {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.tracking-item-reminders {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tracking-chip {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  color: var(--text-secondary);
}

.tracking-chip--active {
  background: #f0f7e8;
  color: var(--brand-500);
  font-weight: 600;
}
