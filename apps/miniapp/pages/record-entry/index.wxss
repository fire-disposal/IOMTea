.record-entry-page {
  min-height: 100vh;
  background: #f8f9fa;
}

.record-entry-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
}

.record-entry-back {
  font-size: 30rpx;
  color: var(--brand-500);
}

.record-entry-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.record-entry-unit {
  font-size: 26rpx;
  color: #6c757d;
}

.record-entry-body {
  padding: 32rpx;
}

.entry-field {
  margin-bottom: 32rpx;
}

.entry-field-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.entry-input {
  background: #fff;
  border-radius: 14rpx;
  padding: 28rpx 24rpx;
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  color: var(--text-primary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.entry-segment-group {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.entry-segment {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s;
}

.entry-segment--active {
  background: var(--brand-500);
  color: #fff;
  border-color: var(--brand-500);
}

.entry-chip-group {
  margin-bottom: 24rpx;
}

.entry-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 20rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid #e8e8e8;
}

.entry-chip--active {
  background: rgba(107, 165, 57, 0.1);
  color: var(--brand-500);
  border-color: var(--brand-500);
}

.entry-med-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 14rpx;
}

.entry-med-name {
  font-size: 30rpx;
  font-weight: 600;
}

.entry-med-actions {
  display: flex;
  gap: 16rpx;
}

.entry-med-btn {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.entry-med-btn--take {
  background: var(--brand-500);
  color: #fff;
}

.entry-med-btn--skip {
  background: #f0f0f0;
  color: #999;
}

.entry-empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.record-entry-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 40rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0e8;
}

.entry-save {
  width: 100%;
  background: var(--brand-500);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 0;
  text-align: center;
}

.entry-save:active {
  transform: scale(0.97);
}

.entry-save[disabled] {
  opacity: 0.6;
}

/* Mini trend inline */
.entry-trend {
  padding: 0 32rpx 32rpx;
}

.entry-trend-canvas {
  width: 100%;
  height: 200rpx;
}
