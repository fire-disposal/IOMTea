.form-shell {
  min-height: 100vh;
  background: var(--bg-page);
}

.form-shell-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.form-shell-back {
  width: 80rpx;
  font-size: 28rpx;
  color: var(--brand-500);
}

.form-shell-title {
  font-size: 34rpx;
  font-weight: 700;
}

.form-shell-body {
  padding: 0 24rpx;
}

.form-number-input {
  width: 100%;
  font-size: 80rpx;
  font-weight: 700;
  text-align: center;
  padding: 40rpx 0;
  background: var(--bg-card);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.segment-picker {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.segment-item--active {
  color: var(--brand-500);
  background: #f0f7e8;
  font-weight: 600;
}

.glucose-section {
  margin-bottom: 24rpx;
}

.glucose-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.form-shell-footer {
  padding: 24rpx;
}

.trend-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.trend-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.trend-val {
  font-size: 22rpx;
  background: var(--bg-card);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: var(--text-secondary);
}

.save-btn {
  width: 100%;
  background: var(--brand-500);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.save-btn--loading {
  opacity: 0.6;
}

.save-btn--saved {
  background: var(--color-success);
}

.segment-item:active { transform: scale(0.96); opacity: 0.8; transition: transform 0.1s; }
