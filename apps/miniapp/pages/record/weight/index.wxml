<view class="form-shell">
  <view class="form-shell-header">
    <text class="form-shell-back" bind:tap="onBack">‹ 返回</text>
    <text class="form-shell-title">记录体重</text>
    <view style="width:80rpx"></view>
  </view>

  <view class="form-shell-body">
    <input type="digit" class="form-number-input" value="{{weight}}" placeholder="65.0"
      bindinput="onWeightInput" focus />

    <view class="weight-section">
      <view class="segment-picker">
        <text wx:for="{{toggleOptions}}" wx:key="value"
          class="segment-item {{showFat === item.value ? 'segment-item--active' : ''}}"
          data-value="{{item.value}}" bind:tap="onToggleTap">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{showFat === 'yes'}}" class="weight-section">
      <input type="digit" class="form-number-input" value="{{bodyFat}}" placeholder="20.0"
        bindinput="onBodyFatInput" />
      <text class="weight-label">体脂率 (%)</text>
    </view>
  </view>

  <view class="form-shell-footer">
    <view wx:if="{{trendData.length}}" class="trend-bar">
      <text class="trend-label">最近7天: </text>
      <text wx:for="{{trendData}}" wx:key="date" class="trend-val">{{item.value}}</text>
    </view>
    <button class="save-btn {{saving ? 'save-btn--loading' : ''}} {{saved ? 'save-btn--saved' : ''}}"
      bind:tap="handleSave" disabled="{{saving}}">
      {{saving ? '保存中...' : saved ? '已保存' : '保存'}}
    </button>
  </view>
</view>
