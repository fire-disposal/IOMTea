<view class="form-shell">
  <view class="form-shell-header">
    <text class="form-shell-back" bind:tap="onBack">‹ 返回</text>
    <text class="form-shell-title">记录生理期</text>
    <view style="width:80rpx"></view>
  </view>
  <view class="form-shell-body">
    <view class="period-section">
      <text class="period-label">日期</text>
      <text class="period-date">{{dateStr}}</text>
    </view>

    <view class="period-section">
      <text class="period-label">流量</text>
      <view class="segment-picker">
        <text wx:for="{{flowOptions}}" wx:key="value"
          class="segment-item {{flow === item.value ? 'segment-item--active' : ''}}"
          data-value="{{item.value}}" bind:tap="onFlowTap">{{item.label}}</text>
      </view>
    </view>

    <view class="period-section">
      <text class="period-label">症状</text>
      <view class="period-chips">
        <text wx:for="{{symptomOptions}}" wx:key="*this"
          class="period-chip {{symptoms.indexOf(item) > -1 ? 'period-chip--active' : ''}}"
          data-value="{{item}}" bind:tap="onSymptomTap">{{item}}</text>
      </view>
    </view>

    <view class="period-section">
      <text class="period-label">备注</text>
      <input class="period-notes" value="{{notes}}" placeholder="选填" bindinput="onNotesInput" />
    </view>
  </view>
  <view class="form-shell-footer">
    <button class="save-btn {{saving ? 'save-btn--loading' : ''}} {{saved ? 'save-btn--saved' : ''}}"
      bind:tap="handleSave" disabled="{{saving}}">
      {{saving ? '保存中...' : saved ? '已保存' : '保存'}}
    </button>
  </view>
</view>
