.form-shell {
  min-height: 100vh;
  background: var(--bg-page);
}

.form-shell-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.form-shell-back {
  width: 80rpx;
  font-size: 28rpx;
  color: var(--brand-500);
}

.form-shell-title {
  font-size: 34rpx;
  font-weight: 700;
}

.form-shell-body {
  padding: 0 24rpx;
}

.form-number-input {
  width: 100%;
  font-size: 60rpx;
  font-weight: 700;
  text-align: center;
  padding: 32rpx 0;
  background: var(--bg-card);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.pressure-grid {
  display: flex;
  gap: 16rpx;
}

.pressure-field {
  flex: 1;
}

.pressure-input {
  font-size: 48rpx;
}

.pressure-hr {
  text-align: center;
}

.pressure-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}

.form-shell-footer {
  padding: 24rpx;
}

.trend-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.trend-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.trend-val {
  font-size: 22rpx;
  background: var(--bg-card);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: var(--text-secondary);
}

.save-btn {
  width: 100%;
  background: var(--brand-500);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.save-btn--loading { opacity: 0.6; }
.save-btn--saved { background: var(--color-success); }
