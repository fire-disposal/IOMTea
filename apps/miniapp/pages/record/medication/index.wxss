.med-page {
  background: var(--bg-page);
  min-height: 100vh;
}

.med-header {
  padding: 24rpx;
}

.med-title {
  font-size: 34rpx;
  font-weight: 700;
}

.med-list {
  padding: 0 24rpx;
}

.med-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.med-item--taken {
  opacity: 0.6;
}

.med-item--skipped {
  opacity: 0.5;
  background: #f8f8f8;
}

.med-drug {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.med-dosage {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.med-time {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.med-actions {
  display: flex;
  gap: 12rpx;
}

.med-btn {
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.med-btn--take {
  background: var(--brand-500);
  color: #fff;
}

.med-btn--skip {
  background: #eee;
  color: var(--text-secondary);
}

.med-status--taken {
  color: var(--brand-500);
  font-size: 26rpx;
}

.med-status--skipped {
  color: #999;
  font-size: 26rpx;
}

.med-empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
}

.med-empty-hint {
  font-size: 24rpx;
  margin-top: 12rpx;
  display: block;
}

.med-btn:active { transform: scale(0.95); transition: transform 0.1s; }
