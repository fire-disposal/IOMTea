.plan-page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.plan-back {
  font-size: 28rpx;
  color: var(--brand-500);
  width: 96rpx;
}

.plan-title {
  font-size: 36rpx;
  font-weight: 700;
}

.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
}

.plan-item-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.plan-item-icon {
  font-size: 36rpx;
}

.plan-item-label {
  font-size: 30rpx;
  font-weight: 600;
}

.plan-item-gear {
  font-size: 32rpx;
  padding: 8rpx;
}

.plan-footer {
  margin-top: 32rpx;
}

.btn-save {
  background: var(--brand-500);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.plan-item:active { background: rgba(0,0,0,0.02); }
.plan-item-gear:active { transform: scale(1.2); transition: transform 0.1s; }
