.pin-page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.pin-page-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.pin-page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin: 8rpx 0 24rpx;
}

.pin-page-skeleton {
  height: 200rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  opacity: 0.5;
}

.pin-card {
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.pin-card-code {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand-500);
  letter-spacing: 8rpx;
  display: block;
}

.pin-card-nickname {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-top: 8rpx;
}

.pin-card-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.pin-card-actions {
  margin-top: 16rpx;
}

.pin-card-copy {
  background: var(--brand-500);
  color: #fff;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.pin-page-nav {
  margin-top: 24rpx;
}

.pin-card-copy:active { opacity: 0.7; transform: scale(0.97); transition: transform 0.1s; }

.pin-skeleton { height: 100rpx; background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; border-radius: 8rpx; margin-bottom: 12rpx; }
