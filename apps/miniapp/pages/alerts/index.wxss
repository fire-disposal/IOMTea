.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.alert-item {
  background: var(--bg-card);
  padding: 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid;
}

.alert-type {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.alert-severity {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
}

.alert-time {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 8rpx;
}

.alert-status {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}
