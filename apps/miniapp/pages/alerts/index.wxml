<view class="page">
  <mp-loading wx:if="{{loading}}" type="circle" show="{{loading}}"></mp-loading>
  <view wx:if="{{!loading && alerts.length === 0}}" class="empty">无告警记录</view>
  <view wx:for="{{alerts}}" wx:key="id" class="alert-item"
    style="border-left-color:{{item.severity === 'critical' ? '#e03131' : item.severity === 'warning' ? '#f08c00' : '#1971c2'}}">
    <text class="alert-type">{{item.metric}}</text>
    <text class="alert-severity"
      style="color:{{item.severity === 'critical' ? '#e03131' : item.severity === 'warning' ? '#f08c00' : '#1971c2'}}">
      {{item.severity}}
    </text>
    <text class="alert-time">{{item.recordedAt}}</text>
    <text class="alert-status">
      {{item.status === 'active' ? '● 活跃' : item.status === 'acknowledged' ? '○ 已确认' : '✓ 已解决'}}
    </text>
  </view>
</view>
