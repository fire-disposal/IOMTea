.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 24rpx;
}

.form-card {
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.form-card-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.form-card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 6rpx;
}

.form-card-meta {
  font-size: 22rpx;
  color: var(--brand-500);
  display: block;
  margin-top: 8rpx;
}

.form-card:active { transform: scale(0.98); opacity: 0.8; transition: transform 0.1s, opacity 0.1s; }

.card-skeleton { height: 120rpx; background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; border-radius: 12rpx; margin-bottom: 16rpx; }
