.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--bg-page);
  overflow: hidden;
}

/* Diagonal flowing rounded bars */
.login-bar {
  position: absolute;
  pointer-events: none;
}

.login-bar--1 { top: 80rpx; left: -400rpx; animation-delay: 0s; transform: rotate(50deg); }
.login-bar--2 { top: 240rpx; left: -300rpx; animation-delay: -2.4s; transform: rotate(52deg); }
.login-bar--3 { top: 420rpx; left: -480rpx; animation-delay: -4.8s; transform: rotate(48deg); }
.login-bar--4 { top: 580rpx; left: -240rpx; animation-delay: -7.2s; transform: rotate(50deg); }
.login-bar--5 { top: 740rpx; left: -360rpx; animation-delay: -9.6s; transform: rotate(48deg); }

.login-bar__inner {
  border-radius: 20rpx;
  opacity: 0.08;
  background: var(--brand-500);
  animation: barFlow 12s linear infinite;
}

.login-bar--1 .login-bar__inner { width: 360rpx; height: 16rpx; opacity: 0.10; }
.login-bar--2 .login-bar__inner { width: 240rpx; height: 12rpx; opacity: 0.08; }
.login-bar--3 .login-bar__inner { width: 440rpx; height: 14rpx; opacity: 0.07; }
.login-bar--4 .login-bar__inner { width: 200rpx; height: 10rpx; opacity: 0.09; }
.login-bar--5 .login-bar__inner { width: 320rpx; height: 16rpx; opacity: 0.06; }

@keyframes barFlow {
  from { transform: translateX(0); }
  to { transform: translateX(1600rpx); }
}

.login-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation-delay: 0.15s;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-icon--bounce {
  animation: iconBounce 1.2s ease-in-out;
}

@keyframes iconBounce {
  0%, 100% { transform: translateY(0); }
  30% { transform: translateY(-12rpx); }
  50% { transform: translateY(0); }
  70% { transform: translateY(-6rpx); }
}

.login-logo {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--brand-500);
  margin-bottom: 16rpx;
  letter-spacing: 8rpx;
}

.login-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 120rpx;
}

.login-btn {
  background: var(--brand-500);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 24rpx 80rpx;
  animation-delay: 0.4s;
}

.login-btn:active {
  transform: scale(0.97);
  transition: transform 0.15s;
}
