.test-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg-page); overflow: hidden; }

/* Top bar */
.test-top { padding: 32rpx 32rpx 16rpx; text-align: center; }
.test-field-name { font-size: 32rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 12rpx; }
.test-progress-dots { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 8rpx; }
.test-dot-indicator { width: 12rpx; height: 12rpx; border-radius: 50%; background: #e0e0e0; transition: all 0.3s; }
.test-dot-indicator--done { background: var(--brand-500); }
.test-dot-indicator--current { background: var(--brand-500); width: 16rpx; height: 16rpx; transform: scale(1.3); }
.test-hint-text { font-size: 22rpx; color: var(--text-secondary); display: block; }

/* Canvas */
.test-canvas { position: relative; display: flex; flex: 1; min-height: 0; }

/* Edge zones */
.test-edge { width: 80rpx; display: flex; align-items: center; justify-content: center; writing-mode: vertical-rl; transition: background 0.2s, width 0.2s; flex-shrink: 0; }
.test-edge--active { width: 120rpx; }
.test-edge-text { font-size: 22rpx; color: #bbb; }
.test-edge--active .test-edge-text { font-weight: 600; }

/* Center area */
.test-center { flex: 1; display: flex; align-items: center; justify-content: center; }

/* Picker — horizontal option bar */
.test-picker { display: flex; gap: 16rpx; padding: 0 16rpx; flex-wrap: wrap; justify-content: center; }
.test-pick { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 140rpx; height: 120rpx; border-radius: 16rpx; background: var(--bg-card); transition: all 0.15s; position: relative; }
.test-pick--hl { background: rgba(107,165,57,0.12); transform: scale(1.08); box-shadow: 0 4rpx 16rpx rgba(107,165,57,0.15); }
.test-pick--locked { background: rgba(107,165,57,0.08); border: 2rpx solid var(--brand-500); }
.test-pick-label { font-size: 28rpx; font-weight: 500; }
.test-pick--hl .test-pick-label { color: var(--brand-500); font-weight: 700; }
.test-pick-lock { position: absolute; top: 4rpx; right: 8rpx; font-size: 18rpx; color: var(--brand-500); }

/* Dial */
.test-dial-wrap { display: flex; flex-direction: column; align-items: center; gap: 16rpx; height: 100%; padding: 16rpx 0; }
.test-dial-zone-bar { display: flex; flex-direction: column; flex: 1; width: 80rpx; border-radius: 12rpx; overflow: hidden; }
.test-dial-zone-seg { flex: 1; transition: opacity 0.2s; }
.test-dial-display { text-align: center; }
.test-dial-val { font-size: 88rpx; font-weight: 700; color: var(--text-primary); display: block; transition: color 0.3s; }
.test-dial-val--live { color: var(--brand-500); }
.test-dial-unit { font-size: 26rpx; color: var(--text-secondary); display: block; }
.test-dial-limits { display: flex; justify-content: space-between; width: 100%; padding: 0 32rpx; font-size: 22rpx; color: #ccc; }

/* Pointer */
.test-pointer { position: fixed; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(107,165,57,0.2); pointer-events: none; z-index: 999; }

/* Trail */
.test-trail-dot { position: absolute; border-radius: 50%; background: var(--brand-500); pointer-events: none; }

/* Lock flash */
.test-lock-flash { position: fixed; inset: 0; background: rgba(107,165,57,0.08); z-index: 99; pointer-events: none; }

/* Result */
.test-result { padding: 32rpx; }
.test-result-title { font-size: 36rpx; font-weight: 700; margin-bottom: 24rpx; }
.test-result-row { display: flex; justify-content: space-between; padding: 24rpx; background: var(--bg-card); border-radius: 14rpx; margin-bottom: 12rpx; }
.test-result-label { font-size: 28rpx; color: var(--text-secondary); }
.test-result-value { font-size: 28rpx; font-weight: 600; color: var(--brand-500); }
.test-reset-btn { width: 100%; background: var(--brand-500); color: #fff; border: none; border-radius: 14rpx; padding: 24rpx; font-size: 30rpx; font-weight: 600; text-align: center; margin-top: 24rpx; }
