.test-page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.test-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.test-title {
  font-size: 36rpx;
  font-weight: 700;
}

.test-step {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.test-progress {
  height: 6rpx;
  background: #e8e8e8;
  border-radius: 3rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.test-progress-bar {
  height: 100%;
  background: var(--brand-500);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.test-drag-zone {
  display: flex;
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  min-height: 600rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.test-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border-right: 1rpx solid #f0f0e8;
}

.test-field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.test-field-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.test-drag-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
  transition: color 0.2s;
}

.test-options {
  width: 280rpx;
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
}

.test-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  transition: transform 0.15s ease, background 0.15s ease;
  height: 80rpx;
}

.test-option--active {
  background: rgba(107,165,57,0.08);
  transform: translateX(-4rpx);
}

.test-option--selected {
  color: var(--brand-500);
  font-weight: 600;
}

.test-option-label {
  font-size: 30rpx;
}

.test-option-check {
  font-size: 28rpx;
  color: var(--brand-500);
}

.test-actions {
  display: flex;
  gap: 16rpx;
}

.test-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.test-btn--back {
  background: #f0f0f0;
  color: var(--text-secondary);
}

.test-btn--done {
  background: var(--brand-500);
  color: #fff;
}

.test-btn--done[disabled] {
  opacity: 0.4;
}

.test-btn--reset {
  background: var(--brand-500);
  color: #fff;
  margin-top: 32rpx;
}

.test-result {
  margin-top: 32rpx;
}

.test-result-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.test-result-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.test-result-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.test-result-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-500);
}
