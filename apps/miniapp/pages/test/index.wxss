.test-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg-page); overflow: hidden; }

.test-top { padding: 32rpx 32rpx 16rpx; text-align: center; flex-shrink: 0; }
.test-form-label { font-size: 36rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 6rpx; }
.test-hint-text { font-size: 22rpx; color: var(--text-secondary); display: block; }

/* Canvas */
.test-canvas { position: relative; display: flex; flex: 1; min-height: 0; border-top: 2rpx solid rgba(0,0,0,0.04); }

/* Dwell progress bar */
.test-dwell-bar {
  position: absolute; top: -2rpx; left: 0; height: 3rpx;
  background: var(--brand-500);
  border-radius: 0 2rpx 2rpx 0;
  opacity: 0; transition: opacity 0.15s;
}
.test-dwell-bar--on { opacity: 1; }

/* Edge zones */
.test-edge { width: 80rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; writing-mode: vertical-rl; transition: background 0.2s, width 0.2s; flex-shrink: 0; position: relative; }
.test-edge--active { width: 120rpx; }
.test-edge--active.test-edge--left { background: rgba(107,165,57,0.12); }
.test-edge--active.test-edge--right { background: rgba(107,165,57,0.12); }
.test-edge-text { font-size: 22rpx; color: #bbb; }
.test-edge--active .test-edge-text { font-weight: 600; color: #666; }

.test-dwell-ring {
  position: absolute; inset: 8rpx; border-radius: 16rpx; border: 3rpx solid var(--brand-500);
  animation: dwellPulse 1s linear forwards; pointer-events: none;
}
@keyframes dwellPulse {
  0%   { border-width: 1rpx; opacity: 0.3; }
  60%  { opacity: 0.8; }
  100% { border-width: 5rpx; opacity: 1; transform: scale(0.94); }
}

/* Columns row */
.test-cols { flex: 1; display: flex; }

.test-col { flex: 1; display: flex; flex-direction: column; padding: 8rpx 12rpx; border-right: 1rpx solid rgba(0,0,0,0.03); transition: background 0.2s; }
.test-col--active { background: rgba(107,165,57,0.04); }
.test-col--locked { background: rgba(107,165,57,0.02); }
.test-col-lock { text-align: center; font-size: 16rpx; color: var(--brand-500); padding-top: 6rpx; padding-bottom: 2rpx; }
.test-col-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #e0e0e0; margin: 10rpx auto 6rpx; }
.test-col-dot--live { background: var(--brand-500); animation: pulse 1.5s ease-in-out infinite; }
.test-col-label { text-align: center; font-size: 22rpx; color: var(--text-secondary); padding: 8rpx 0; margin-bottom: 4rpx; border-bottom: 1rpx solid #f0f0e8; flex-shrink: 0; }

/* Picker column */
.test-picker-col { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 4rpx; }
.test-opt { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 12rpx; border-radius: 10rpx; transition: all 0.1s; }
.test-opt--hl { background: rgba(107,165,57,0.12); }
.test-opt--locked { background: rgba(107,165,57,0.06); border: 1rpx solid var(--brand-500); }
.test-opt-label { font-size: 26rpx; font-weight: 500; }
.test-opt--hl .test-opt-label { color: var(--brand-500); font-weight: 700; }
.test-opt-check { font-size: 20rpx; color: var(--brand-500); }

/* Dial column */
.test-dial-col { flex: 1; display: flex; align-items: center; gap: 12rpx; padding: 8rpx 0; }
.test-dial-zone-bar { width: 100%; flex-shrink: 0; display: flex; flex-direction: column; flex: 1; border-radius: 8rpx; overflow: hidden; }
.test-dial-zone-seg { flex: 1; transition: opacity 0.15s; }
.test-dial-display { flex: 1; text-align: center; }
.test-dial-val { font-size: 48rpx; font-weight: 700; color: var(--text-primary); display: block; transition: color 0.3s; }
.test-dial-val--live { color: var(--brand-500); }
.test-dial-unit { font-size: 22rpx; color: var(--text-secondary); display: block; }
.test-dial-limits { display: flex; justify-content: space-between; font-size: 18rpx; color: #ccc; padding: 0 4rpx; }

/* Pointer */
.test-pointer { position: fixed; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(107,165,57,0.18); pointer-events: none; z-index: 999; }

/* Trail */
.test-trail-dot { position: absolute; border-radius: 50%; background: var(--brand-500); pointer-events: none; }

/* Lock flash */
.test-lock-flash { position: fixed; inset: 0; background: rgba(107,165,57,0.06); z-index: 99; pointer-events: none; }

/* Result */
.test-result { padding: 32rpx; text-align: center; }
.test-result-title { font-size: 40rpx; font-weight: 700; margin-bottom: 24rpx; }
.test-reset-btn { width: 100%; background: var(--brand-500); color: #fff; border: none; border-radius: 14rpx; padding: 24rpx; font-size: 30rpx; font-weight: 600; text-align: center; margin-top: 24rpx; }

/* Chain bar */
.test-chain { position: absolute; bottom: 0; left: 80rpx; right: 80rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; gap: 0; pointer-events: none; }
.test-chain-node { width: 16rpx; height: 16rpx; border-radius: 50%; background: #e0e0e0; display: flex; align-items: center; justify-content: center; transition: all 0.3s; position: relative; flex-shrink: 0; }
.test-chain-node--active { background: var(--brand-500); transform: scale(1.5); box-shadow: 0 0 12rpx rgba(107,165,57,0.3); }
.test-chain-node--locked { background: var(--brand-500); width: 24rpx; height: 24rpx; }
.test-chain-text { position: absolute; top: -28rpx; font-size: 18rpx; color: var(--brand-500); white-space: nowrap; }
.test-chain-link { width: 48rpx; height: 2rpx; background: #e0e0e0; transition: background 0.3s; }
.test-chain-link--active { background: var(--brand-500); }
