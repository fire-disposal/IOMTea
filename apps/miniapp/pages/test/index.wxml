<view class="test-page">
  <view class="test-top">
    <text class="test-form-label">{{fl}}</text>
    <view class="test-metric-bar">
      <view wx:for="{{metricChips}}" wx:key="v" wx:for-index="mi"
        class="test-metric-chip {{metricSelIdx === mi ? 'test-metric-chip--on' : ''}}"
        data-idx="{{mi}}" bind:tap="onMetricTap">
        <text>{{item.l}}</text>
      </view>
    </view>
  </view>

  <view class="test-canvas"
    bindtouchstart="onStart" bindtouchmove="onMove" bindtouchend="onEnd">

    <!-- Dwell bar -->
    <view class="test-dwell-bar {{dbv ? 'test-dwell-bar--on' : ''}}" style="width:{{dp}}%"></view>

    <!-- Left edge zone — guidance or submit -->
    <view class="test-edge test-edge--left {{lza ? 'test-edge--active' : ''}}">
      <text wx:if="{{odd}}" class="test-edge-guide">{{lza ? '→' : guide}}</text>
      <text wx:else class="test-edge-guide">{{lza ? otherLabel : otherLabel}}</text>
    </view>

    <!-- Columns -->
    <view class="test-cols">
      <view wx:for="{{chainFields}}" wx:key="id" wx:for-index="ci"
        class="test-col {{ac === ci ? 'test-col--active' : ''}} {{item.done ? 'test-col--locked' : ''}}">
        <text class="test-col-label">{{item.label}}</text>

        <view wx:if="{{item.type === 'picker'}}" class="test-picker-col">
          <view wx:for="{{item.options}}" wx:key="v" wx:for-index="oi" wx:for-item="opt"
            class="test-opt {{item.selIdx === oi ? 'test-opt--locked' : ''}}">
            <text class="test-opt-label">{{opt.l}}</text>
            <text wx:if="{{item.selIdx === oi}}" class="test-opt-check">✓</text>
            <view wx:if="{{oi < item.options.length - 1}}" class="test-opt-divider"></view>
          </view>
        </view>

        <view wx:if="{{item.type === 'dial'}}" class="test-dial-col">
          <view class="test-dial-zones">
            <view wx:for="{{dz}}" wx:key="name" wx:for-index="zi"
              class="test-dial-zone {{ac === ci && daz === item.name ? 'test-dial-zone--on' : ''}}"
              style="background:{{item.c}};opacity:{{ac === ci && daz === item.name ? 0.2 : 0}}">
            </view>
          </view>
          <view class="test-dial-display {{item.done ? 'test-dial-locked' : ''}}">
            <text class="test-dial-val {{ac === ci && dlv ? 'test-dial-val--live' : ''}} {{stl === 1 ? 'test-dial-settle' : ''}}">{{item.selLabel || ''}}</text>
            <text class="test-dial-unit">{{item.unit}}</text>
          </view>
          <view class="test-dial-limits"><text>{{item.min}}</text><text>{{item.max}}</text></view>
        </view>
      </view>

      <!-- Connector lines between locked options -->
      <view wx:for="{{connectors}}" wx:key="i" class="test-connector"
        style="left:{{item.x1}}px;top:{{item.y}}px;width:{{item.w}}px">
      </view>
    </view>

    <!-- Right edge zone — submit or guidance -->
    <view class="test-edge test-edge--right {{rza ? 'test-edge--active' : ''}}">
      <text wx:if="{{odd}}" class="test-edge-guide">{{rza ? otherLabel : otherLabel}}</text>
      <text wx:else class="test-edge-guide">{{rza ? '←' : guide}}</text>
    </view>

    <view wx:if="{{pv}}" class="test-pointer" style="left:{{px}}px;top:{{py}}px"></view>
    <view wx:for="{{trail}}" wx:key="i" class="test-trail-dot" style="left:{{item.x}}px;top:{{item.y}}px;opacity:{{item.o}};width:{{item.w}}rpx;height:{{item.w}}rpx"></view>
  </view>

  <!-- Selection preview row -->
  <view wx:if="{{!ad}}" class="test-preview">
    <view wx:for="{{chainFields}}" wx:key="id" wx:for-index="si"
      class="test-preview-col {{item.done ? 'test-preview-col--done' : ''}}">
      <text class="test-preview-label">{{item.label}}</text>
      <text class="test-preview-value">{{item.selLabel || '—'}}</text>
    </view>
  </view>

  <view wx:if="{{lf}}" class="test-lock-flash"></view>
  <view wx:if="{{ad}}" class="test-result anim-fade-up">
    <text class="test-result-title">✓ 全部完成</text>
    <button class="test-reset-btn" bind:tap="reset">再来一轮</button>
  </view>
</view>
