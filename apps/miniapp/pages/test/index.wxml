<view class="test-page">
  <text class="test-title">一笔填写</text>
  <text class="test-hint">从左到右一笔画 · 左侧取消区 · 右侧提交区</text>

  <view class="test-canvas"
    bindtouchstart="onStart"
    bindtouchmove="onMove"
    bindtouchend="onEnd">

    <!-- Cancel zone (left edge) -->
    <view class="test-zone test-zone--cancel {{inCancelZone ? 'test-zone--active' : ''}}">
      <text>← 松手取消</text>
    </view>

    <!-- Columns -->
    <view class="test-columns">
      <view wx:for="{{columns}}" wx:key="id" wx:for-item="col" wx:for-index="ci"
        class="test-column {{col.active ? 'test-column--active' : ''}} {{col.done ? 'test-column--done' : ''}} {{col.revisiting ? 'test-column--revisit' : ''}}">
        <text class="test-column-label">{{col.label}}</text>
        <view wx:for="{{col.options}}" wx:key="value" wx:for-item="opt" wx:for-index="oi"
          class="test-opt {{col.active && col.highlightIdx === oi ? 'test-opt--highlight' : ''}} {{col.selectedIdx === oi ? 'test-opt--picked' : ''}}">
          <text class="test-opt-label">{{opt.label}}</text>
          <text wx:if="{{col.selectedIdx === oi}}" class="test-opt-check">●</text>
        </view>
      </view>
    </view>

    <!-- Submit zone (right edge) -->
    <view class="test-zone test-zone--submit {{inSubmitZone ? 'test-zone--active' : ''}}">
      <text>松手提交 →</text>
    </view>

    <!-- Path trace dots -->
    <view wx:for="{{path}}" wx:key="i" class="test-dot"
      style="left:{{item.x}}px;top:{{item.y}}px;opacity:{{item.opacity}}">
    </view>
  </view>

  <!-- Info bar -->
  <view class="test-info">
    <text wx:if="{{inCancelZone}}" class="test-info-warn">松手将取消</text>
    <text wx:elif="{{inSubmitZone}}" class="test-info-ok">松手提交全部选择</text>
    <text wx:elif="{{activeColumn >= 0}}" class="test-info-normal">正在选择: {{columns[activeColumn].label}}</text>
    <text wx:else class="test-info-dim">向右拖动开始</text>
  </view>

  <!-- Result -->
  <view wx:if="{{done}}" class="test-result anim-fade-up">
    <text class="test-result-title">✓ 提交成功</text>
    <view wx:for="{{columns}}" wx:key="id" class="test-result-item">
      <text class="test-result-label">{{item.label}}</text>
      <text class="test-result-value">{{item.selectedLabel || '—'}}</text>
    </view>
    <button class="test-reset-btn" bind:tap="onReset">再来一次</button>
  </view>

  <view wx:if="{{cancelled}}" class="test-cancelled anim-fade-up">
    <text class="test-cancelled-text">已取消</text>
    <button class="test-reset-btn" bind:tap="onReset">重新开始</button>
  </view>
</view>
