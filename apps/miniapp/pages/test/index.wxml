<view class="test-page">
  <!-- Top: field indicator + progress -->
  <view class="test-top">
    <text class="test-field-name">{{currentField.label}}</text>
    <view class="test-progress-dots">
      <view wx:for="{{fields}}" wx:key="id" wx:for-index="fi"
        class="test-dot-indicator {{fi < currentIdx ? 'test-dot-indicator--done' : ''}} {{fi === currentIdx ? 'test-dot-indicator--current' : ''}}">
      </view>
    </view>
    <text class="test-hint-text">{{hintText}}</text>
  </view>

  <!-- Interaction canvas -->
  <view class="test-canvas"
    bindtouchstart="onStart"
    bindtouchmove="onMove"
    bindtouchend="onEnd">

    <!-- Left zone -->
    <view class="test-edge test-edge--left {{leftZoneActive ? 'test-edge--active' : ''}}"
      style="background:{{leftZoneBg}}">
      <text class="test-edge-text">{{leftLabel}}</text>
    </view>

    <!-- Center: content area -->
    <view class="test-center">

      <!-- Picker mode: horizontal option bar -->
      <view wx:if="{{mode === 'picker'}}" class="test-picker">
        <view wx:for="{{currentField.options}}" wx:key="value" wx:for-index="oi"
          class="test-pick {{highlightIdx === oi ? 'test-pick--hl' : ''}} {{currentField.selectedIdx === oi ? 'test-pick--locked' : ''}}">
          <text class="test-pick-label">{{item.label}}</text>
          <text wx:if="{{currentField.selectedIdx === oi}}" class="test-pick-lock">✓</text>
        </view>
      </view>

      <!-- Dial mode: speed-dial number -->
      <view wx:if="{{mode === 'dial'}}" class="test-dial-wrap">
        <view class="test-dial-zone-bar">
          <view wx:for="{{dialZones}}" wx:key="name" class="test-dial-zone-seg"
            style="opacity:{{dialActiveZone === item.name ? 0.35 : 0.06}};background:{{item.color}}">
          </view>
        </view>
        <view class="test-dial-display">
          <text class="test-dial-val {{dialLive ? 'test-dial-val--live' : ''}}">{{displayValue}}</text>
          <text class="test-dial-unit">{{currentField.unit}}</text>
        </view>
        <view class="test-dial-limits">
          <text>{{currentField.min}}</text>
          <text>{{currentField.max}}</text>
        </view>
      </view>
    </view>

    <!-- Right zone -->
    <view class="test-edge test-edge--right {{rightZoneActive ? 'test-edge--active' : ''}}"
      style="background:{{rightZoneBg}}">
      <text class="test-edge-text">{{rightLabel}}</text>
    </view>

    <!-- Pointer glow -->
    <view wx:if="{{pointerVisible}}" class="test-pointer"
      style="left:{{pointerX}}px;top:{{pointerY}}px;opacity:{{pointerOpacity}}">
    </view>

    <!-- Trail -->
    <view wx:for="{{trail}}" wx:key="i" class="test-trail-dot"
      style="left:{{item.x}}px;top:{{item.y}}px;opacity:{{item.o}};width:{{item.w}}rpx;height:{{item.w}}rpx">
    </view>
  </view>

  <!-- Lock flash overlay -->
  <view wx:if="{{lockFlash}}" class="test-lock-flash anim-scale-in"></view>

  <!-- Done result -->
  <view wx:if="{{done}}" class="test-result anim-fade-up">
    <text class="test-result-title">✓ 完成</text>
    <view wx:for="{{fields}}" wx:key="id" class="test-result-row">
      <text class="test-result-label">{{item.label}}</text>
      <text class="test-result-value">{{item.selectedLabel || '—'}}</text>
    </view>
    <button class="test-reset-btn" bind:tap="reset">再来一次</button>
  </view>
</view>
