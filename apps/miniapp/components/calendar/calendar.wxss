.calendar {
  background: var(--bg-card, #fff);
  border-radius: var(--border-radius, 12px);
  padding: 12px;
  margin-bottom: 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.calendar__header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 12px;
}

.calendar__nav {
  font-size: 14px;
  color: var(--brand-500, #6BA539);
  padding: 4px 12px;
}

.calendar__title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary, #3C3C3C);
  margin: 0 16px;
}

.calendar__weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 4px;
}

.calendar__weekday {
  font-size: 12px;
  color: var(--text-secondary, #8C8C7E);
  padding: 4px 0;
}

.calendar__grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar__day {
  text-align: center;
  padding: 6px 0;
  position: relative;
  min-height: 36px;
  border-radius: 8px;
}

.calendar__day--empty {
  visibility: hidden;
}

.calendar__day--today {
  background: rgba(107, 165, 57, 0.12);
}

.calendar__day-num {
  display: block;
  font-size: 14px;
  color: var(--text-primary, #3C3C3C);
  line-height: 1.4;
}

.calendar__day--today .calendar__day-num {
  color: var(--brand-500, #6BA539);
  font-weight: 700;
}

.calendar__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
  margin-top: 2px;
}

.calendar__dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--brand-500, #6BA539);
}

.calendar__dot-more {
  font-size: 9px;
  color: var(--text-secondary, #8C8C7E);
}
