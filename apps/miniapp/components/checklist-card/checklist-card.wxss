.checklist-card {
  background: #fff;
  border-radius: 12px;
  margin-bottom: 10px;
  position: relative;
  overflow: hidden;
}

.checklist-card:active {
  transform: scale(0.97);
  transition: transform 0.1s;
}

.checklist-card__accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  border-radius: 4px 0 0 4px;
}

.checklist-card--done {
  opacity: 0.68;
}

.checklist-card--done .checklist-card__accent {
  background: #4A8C3F;
}

.checklist-card--done .checklist-card__icon-wrap {
  background: #E8F5E9;
}

.checklist-card--done .checklist-card__check {
  color: #4A8C3F;
  font-size: 18px;
  font-weight: 700;
}

.checklist-card--pending .checklist-card__accent {
  background: #E0D4C0;
}

.checklist-card--pending .checklist-card__icon-wrap {
  background: #F5F0E8;
}

.checklist-card--pending .checklist-card__hint {
  font-size: 12px;
  color: #ED6C02;
}

.checklist-card--skipped {
  opacity: 0.5;
}

.checklist-card--skipped .checklist-card__accent {
  background: #E0E0E0;
}

.checklist-card--skipped .checklist-card__skip {
  color: #BDBDBD;
  font-size: 16px;
}

.checklist-card__body {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
}

.checklist-card__icon-wrap {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checklist-card__icon {
  font-size: 22px;
}

.checklist-card__info {
  flex: 1;
  min-width: 0;
}

.checklist-card__label {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary, #3C3C3C);
}

.checklist-card__status {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  position: relative;
}

.checklist-card__circle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid #E0D4C0;
}

.checklist-card__credit {
  position: absolute;
  right: 0;
  top: -4px;
  font-size: 13px;
  font-weight: 700;
  color: #E6A817;
  white-space: nowrap;
  pointer-events: none;
}
