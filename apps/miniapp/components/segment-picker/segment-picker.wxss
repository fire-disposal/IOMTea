.segment-picker {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.segment-picker__item {
  padding: 10px 20px;
  background: white;
  border-radius: 20px;
  font-size: 16px;
  color: #495057;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  transition: background 0.2s ease, color 0.2s ease;
}

.segment-picker__item:active { transform: scale(0.96); opacity: 0.8; }

.segment-picker__item--active {
  background: #4a90d9;
  color: white;
  font-weight: 500;
}
