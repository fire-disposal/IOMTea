.messages-page {
  padding: 32rpx 24rpx 100rpx;
}

.messages-page-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.messages-page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin: 8rpx 0 24rpx;
}

.card-skeleton {
  height: 64rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  background: var(--text-secondary);
  opacity: 0.12;
}

.alert-item {
  background: var(--bg-card);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

.alert-item-header {
  display: flex;
  justify-content: space-between;
}

.alert-item-metric {
  font-size: 28rpx;
  font-weight: 600;
}

.alert-item-severity {
  font-size: 24rpx;
  font-weight: 600;
}

.alert-item-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.alert-item-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.alert-item-status {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.messages-page-empty {
  text-align: center;
  padding: 120rpx 0;
}

.messages-page-empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f7e8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.messages-page-empty-icon-text {
  font-size: 48rpx;
  color: var(--brand-500);
}

.messages-page-empty-title {
  font-size: 30rpx;
  display: block;
  margin-bottom: 8rpx;
}

.messages-page-empty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
}
