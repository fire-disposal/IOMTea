.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.device-item {
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.device-serial {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.device-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.device-type {
  font-size: 24rpx;
  color: var(--brand-500);
}

.device-status {
  font-size: 24rpx;
  color: var(--text-secondary);
}
