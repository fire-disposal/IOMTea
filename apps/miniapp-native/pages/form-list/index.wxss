.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 24rpx;
}

.form-card {
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.form-card-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.form-card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 6rpx;
}

.form-card-meta {
  font-size: 22rpx;
  color: var(--brand-500);
  display: block;
  margin-top: 8rpx;
}
