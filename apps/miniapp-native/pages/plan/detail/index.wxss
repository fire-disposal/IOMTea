.plan-detail {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.plan-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.plan-detail-back {
  font-size: 28rpx;
  color: var(--brand-500);
  width: 96rpx;
}

.plan-detail-title {
  font-size: 32rpx;
  font-weight: 700;
}

.plan-detail-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.plan-detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.reminder-slot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.reminder-slot-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reminder-slot-label {
  font-size: 28rpx;
}

.reminder-slot-time {
  font-size: 28rpx;
  color: var(--brand-500);
}

.plan-detail-footer {
  margin-top: 24rpx;
}

.btn-save {
  background: var(--brand-500);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
