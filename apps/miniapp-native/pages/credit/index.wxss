.credit-page {
  min-height: 100vh;
  background: var(--bg-page);
}

.credit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.credit-back {
  font-size: 28rpx;
  color: var(--brand-500);
  width: 96rpx;
}

.credit-title {
  font-size: 36rpx;
  font-weight: 700;
}

.credit-balance {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  gap: 12rpx;
}

.credit-balance-icon {
  font-size: 40rpx;
}

.credit-balance-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--brand-500);
}

.credit-list {
  padding: 0 24rpx;
}

.credit-tx {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.credit-tx-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.credit-tx-icon {
  font-size: 36rpx;
}

.credit-tx-label {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.credit-tx-date {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.credit-tx-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-500);
}

.credit-empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
}
