.form-shell{min-height:100vh;background:var(--bg-page)}
.form-shell-header{display:flex;justify-content:space-between;align-items:center;padding:24rpx}
.form-shell-back{width:80rpx;font-size:28rpx;color:var(--brand-500)}
.form-shell-title{font-size:34rpx;font-weight:700}
.form-shell-body{padding:0 24rpx}
.segment-picker{display:flex;background:var(--bg-card);border-radius:16rpx;overflow:hidden}
.segment-item{flex:1;text-align:center;padding:18rpx 0;font-size:26rpx;color:var(--text-secondary)}
.segment-item--active{color:var(--brand-500);background:#f0f7e8;font-weight:600}
.period-section{margin-bottom:24rpx}
.period-label{font-size:28rpx;font-weight:600;margin-bottom:12rpx;display:block}
.period-date{font-size:32rpx;padding:20rpx;background:var(--bg-card);border-radius:12rpx;display:block;text-align:center}
.period-chips{display:flex;flex-wrap:wrap;gap:12rpx}
.period-chip{font-size:26rpx;padding:12rpx 24rpx;background:var(--bg-card);border-radius:20rpx;color:var(--text-secondary)}
.period-chip--active{background:#f0f7e8;color:var(--brand-500);font-weight:600}
.period-notes{width:100%;padding:20rpx;background:var(--bg-card);border-radius:12rpx;font-size:28rpx}
.form-shell-footer{padding:24rpx}
.save-btn{width:100%;background:var(--brand-500);color:#fff;border-radius:16rpx;font-size:32rpx;font-weight:600;padding:24rpx 0}
.save-btn--loading{opacity:.6}
.save-btn--saved{background:var(--color-success)}
