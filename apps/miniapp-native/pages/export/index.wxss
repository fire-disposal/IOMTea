.export-page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.export-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.export-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin: 8rpx 0 24rpx;
}

.export-modules {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.export-chip {
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  color: var(--text-secondary);
}

.export-chip--active {
  background: #f0f7e8;
  color: var(--brand-500);
  font-weight: 600;
}

.export-footer {
  margin-top: 48rpx;
}

.export-btn {
  background: var(--brand-500);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
