<view class="export-page">
  <text class="export-title">导出健康数据</text>
  <text class="export-subtitle">选择要导出的模块</text>
  <view class="export-modules">
    <text wx:for="{{modules}}" wx:key="value"
      class="export-chip {{selectedTypes.indexOf(item.value) > -1 ? 'export-chip--active' : ''}}"
      data-type="{{item.value}}" bind:tap="onTypeToggle">{{item.label}}</text>
  </view>
  <view class="export-footer">
    <button class="export-btn" bind:tap="handleExport">导出 CSV ({{selectedTypes.length}} 个模块)</button>
  </view>
</view>
