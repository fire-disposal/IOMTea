.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.picker {
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.vital-item {
  display: flex;
  justify-content: space-between;
  background: var(--bg-card);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.vital-metric {
  font-size: 28rpx;
  font-weight: 600;
}

.vital-value {
  font-size: 28rpx;
  color: var(--brand-500);
}
