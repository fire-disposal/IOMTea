<view class="profile-page">
  <view class="profile-header">
    <text class="profile-name">{{user.displayName || user.username}}</text>
  </view>

  <view class="profile-stats">
    <view class="profile-stat" data-url="/pages/credit/index" bind:tap="onNavigate">
      <text class="profile-stat-num">{{credit}}</text>
      <text class="profile-stat-label">积分</text>
    </view>
    <view class="profile-stat">
      <text class="profile-stat-num">{{recordCount}}</text>
      <text class="profile-stat-label">记录</text>
    </view>
  </view>

  <view class="profile-menu">
    <view class="profile-menu-item" data-url="/pages/credit/index" bind:tap="onNavigate">
      <text>积分明细</text>
    </view>
    <view class="profile-menu-item" data-url="/pages/plan/index" bind:tap="onNavigate">
      <text>健康计划</text>
    </view>
    <view class="profile-menu-item" data-url="/pages/alerts/index" bind:tap="onNavigate">
      <text>告警中心</text>
    </view>
    <view class="profile-menu-item" data-url="/pages/settings/index" bind:tap="onNavigate">
      <text>系统设置</text>
    </view>
    <view class="profile-menu-item" data-url="/pages/patient-select/index" bind:tap="onNavigate">
      <text>切换患者</text>
    </view>
    <view class="profile-menu-item" data-url="/pages/pin-overview/index" bind:tap="onNavigate">
      <text>设备连接</text>
    </view>
    <view class="profile-menu-item" bind:tap="handleSync">
      <text>同步数据</text>
    </view>
    <view class="profile-menu-item" bind:tap="handleLogout">
      <text style="color:#e03131">退出登录</text>
    </view>
  </view>
</view>
