.profile-page {
  padding-bottom: 100rpx;
}

.profile-header {
  padding: 48rpx 24rpx 24rpx;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 700;
}

.profile-stats {
  display: flex;
  padding: 0 24rpx 24rpx;
  gap: 24rpx;
}

.profile-stat {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.profile-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand-500);
  display: block;
}

.profile-stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
}

.profile-menu {
  padding: 0 24rpx;
}

.profile-menu-item {
  background: var(--bg-card);
  padding: 28rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
}
