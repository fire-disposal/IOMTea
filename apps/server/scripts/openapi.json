{
  "openapi": "3.0.0",
  "info": {
    "title": "IOMTea API",
    "version": "2.0.0",
    "description": "Home health IoT monitoring"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 50,
                    "example": "researcher"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "secret123"
                  },
                  "displayName": {
                    "type": "string",
                    "example": "研究员"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created"
          },
          "409": {
            "description": "Username taken"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "example": "admin123"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "example": "..."
                  }
                },
                "required": [
                  "refreshToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed"
          },
          "401": {
            "description": "Invalid refresh token"
          }
        }
      }
    },
    "/users": {
      "get": {
        "responses": {
          "200": {
            "description": "User list"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Current user"
          }
        }
      }
    },
    "/users/:id": {
      "patch": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "responses": {
          "200": {
            "description": "Dashboard summary"
          }
        }
      }
    },
    "/pins": {
      "get": {
        "responses": {
          "200": {
            "description": "PIN list"
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pin": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6,
                    "example": "123456"
                  },
                  "userId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "device",
                      "virtual",
                      "user",
                      "simulator"
                    ],
                    "default": "device"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "userId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/pins/:code": {
      "delete": {
        "responses": {
          "200": {
            "description": "Revoked"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/tags": {
      "get": {
        "responses": {
          "200": {
            "description": "Tag list"
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50,
                    "example": "高血压"
                  },
                  "color": {
                    "type": "string",
                    "example": "#ff6b6b"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/tags/:id": {
      "delete": {
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/patients": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "search",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Patient list"
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "张三"
                  },
                  "birthDate": {
                    "type": "string",
                    "example": "1960-01-01"
                  },
                  "gender": {
                    "type": "string",
                    "example": "male"
                  },
                  "heightCm": {
                    "type": "number"
                  },
                  "weightKg": {
                    "type": "number"
                  },
                  "bloodType": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "object",
                    "additionalProperties": {
                      "nullable": true
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/patients/:id": {
      "get": {
        "responses": {
          "200": {
            "description": "Patient detail"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "gender": {
                    "type": "string"
                  },
                  "heightCm": {
                    "type": "number"
                  },
                  "weightKg": {
                    "type": "number"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "object",
                    "additionalProperties": {
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/patients/:id/users": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "relation": {
                    "type": "string",
                    "example": "caregiver"
                  }
                },
                "required": [
                  "userId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User linked"
          }
        }
      }
    },
    "/patients/:id/users/:userId": {
      "delete": {
        "responses": {
          "200": {
            "description": "User unlinked"
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "patientId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "severity",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Alert list"
          }
        }
      }
    },
    "/alerts/:id": {
      "get": {
        "responses": {
          "200": {
            "description": "Alert detail"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "acknowledge",
                      "resolve",
                      "assign"
                    ]
                  },
                  "assigneeId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/alerts/:id/close": {
      "post": {
        "responses": {
          "200": {
            "description": "Closed"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/alert-rules/patients/:id/alert-rules": {
      "get": {
        "responses": {
          "200": {
            "description": "Alert rules for patient"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "enabled": {
                          "type": "boolean",
                          "default": true
                        },
                        "label": {
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "metric"
                      ]
                    }
                  }
                },
                "required": [
                  "rules"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/ingest/single": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "patientId": {
                    "type": "string",
                    "format": "uuid",
                    "example": "00000000-0000-0000-0000-000000000001"
                  },
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "pinCode": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "example": "observation"
                  },
                  "source": {
                    "type": "string",
                    "example": "device"
                  },
                  "metric": {
                    "type": "string",
                    "minLength": 1,
                    "example": "heart_rate"
                  },
                  "value": {
                    "nullable": true
                  },
                  "unit": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number"
                  },
                  "tags": {
                    "type": "object",
                    "additionalProperties": {
                      "nullable": true
                    }
                  },
                  "recordedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "patientId",
                  "kind",
                  "source",
                  "metric"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ingested"
          },
          "400": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/ingest/batch": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "patientId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "sessionId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "pinCode": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "metric": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "nullable": true
                        },
                        "unit": {
                          "type": "string"
                        },
                        "confidence": {
                          "type": "number"
                        },
                        "tags": {
                          "type": "object",
                          "additionalProperties": {
                            "nullable": true
                          }
                        },
                        "recordedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "patientId",
                        "kind",
                        "source",
                        "metric"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 5000
                  }
                },
                "required": [
                  "events"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result"
          }
        }
      }
    },
    "/data/metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Metric list"
          }
        }
      }
    },
    "/data/raw": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "patientId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "metric",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "fieldPath",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": true,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000,
              "default": 200
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Raw time series"
          }
        }
      }
    },
    "/data/aggregate": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "patientId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "metric",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "fieldPath",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": true,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "minute",
                "hour",
                "day",
                "week"
              ],
              "default": "day"
            },
            "required": false,
            "name": "interval",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "avg",
                "min",
                "max",
                "count"
              ],
              "default": "avg"
            },
            "required": false,
            "name": "fn",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated time series"
          }
        }
      }
    },
    "/data/latest": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "patientId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Latest values"
          }
        }
      }
    },
    "/export/preview": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "patientId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Data preview"
          }
        }
      }
    },
    "/export/download": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "patientId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "metrics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "csv",
                      "long",
                      "wide"
                    ]
                  }
                },
                "required": [
                  "format"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Export file (base64)"
          }
        }
      }
    },
    "/twin/profiles": {
      "get": {
        "responses": {
          "200": {
            "description": "Profile list"
          }
        }
      }
    },
    "/twin/profiles/:name": {
      "get": {
        "responses": {
          "200": {
            "description": "Profile config"
          }
        }
      }
    },
    "/twin/simulations": {
      "get": {
        "responses": {
          "200": {
            "description": "Simulation list"
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string",
                    "example": "elderly-cardiac"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "profile"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/twin/simulations/:id": {
      "get": {
        "responses": {
          "200": {
            "description": "Simulation detail"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/twin/simulations/:id/toggle": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "running": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "running"
