# ============================================================
# IOMTea 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================================

# ---- 数据库 ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/iomtea

# ---- JWT 认证 ----
JWT_SECRET=change-me-to-a-random-64-character-string-here
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---- 服务器 ----
PORT=3000
NODE_ENV=development

# ---- CORS ----
# 多个来源用逗号分隔
CORS_ORIGIN=http://localhost:5173

# ---- MQTT (设备数据接入) ----
MQTT_ENABLED=false
MQTT_BROKER=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ---- 演示模式 ----
# 启用后自动创建演示账户和数据
DEMO_MODE=true

# ---- TCP 数据接入 (可选) ----
# TCP_INGEST_PORT=5858
# TCP_INGEST_TOKEN=

# ---- 微信小程序 (可选) ----
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# ---- Docker Compose 部署 ----
# DB_PASSWORD=postgres
# MQTT_PORT=1883
# SERVER_PORT=3000
# WEB_PORT=80
# GATEWAY_PORT=5858
# IMAGE_REPO=your-github-user/iomtea
# IMAGE_TAG=latest

